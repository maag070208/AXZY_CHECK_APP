<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      tools:replace="android:allowBackup"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="false"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">

      <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="AIzaSyBEcey4scuaufZ6TD4oOZZKjO-CIOVXa8w" />

      <activity
        android:name=".SplashActivity"
        android:label="@string/app_name"
        android:theme="@style/SplashTheme"
        android:noHistory="true"
        android:exported="true" />

      <!-- Actividad técnica para `npx react-native run-android`.
           En release queda deshabilitada; el launcher real son los alias por rol. -->
      <activity
        android:name=".CliLauncher"
        android:enabled="${cliLauncherEnabled}"
        android:exported="true"
        android:noHistory="true"
        android:theme="@style/AppTheme">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Launchers por rol. El módulo nativo RoleIcon activa solo uno. -->
      <activity-alias
        android:name=".RoleAliasAdmin"
        android:targetActivity=".SplashActivity"
        android:enabled="true"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_admin"
        android:roundIcon="@mipmap/ic_launcher_admin"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".RoleAliasShift"
        android:targetActivity=".SplashActivity"
        android:enabled="false"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_shift"
        android:roundIcon="@mipmap/ic_launcher_shift"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".RoleAliasGuard"
        android:targetActivity=".SplashActivity"
        android:enabled="false"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_guard"
        android:roundIcon="@mipmap/ic_launcher_guard"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".RoleAliasResdn"
        android:targetActivity=".SplashActivity"
        android:enabled="false"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_resdn"
        android:roundIcon="@mipmap/ic_launcher_resdn"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".RoleAliasMaint"
        android:targetActivity=".SplashActivity"
        android:enabled="false"
        android:exported="true"
        android:icon="@mipmap/ic_launcher_maint"
        android:roundIcon="@mipmap/ic_launcher_maint"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="false" />

    </application>
</manifest>
